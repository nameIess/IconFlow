# Client-side search protection.
# These values are public in a Vite browser build; they do NOT increase
# macOSicons quotas and must not contain API secrets.

# Number of icons requested per search page.
VITE_SEARCH_PAGE_SIZE=100

# Minimum delay between outbound search requests.
VITE_MIN_SEARCH_INTERVAL_MS=1500

# Keep identical search pages in memory for this many milliseconds.
VITE_SEARCH_CACHE_TTL_MS=120000

# Pause new searches after a real HTTP 429 response.
VITE_RATE_LIMIT_COOLDOWN_MS=60000

# Browser-side safety window for outbound searches.
VITE_SEARCH_WINDOW_MS=60000
VITE_MAX_SEARCHES_PER_WINDOW=20
