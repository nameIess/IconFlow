# mac-icns example environment configuration
# Copy this file to .env and replace values as needed.

# Required: API key from https://macosicons.com
MACOSICONS_API_KEY=your_api_key_here


# Base download directory for .icns files
# Windows example: %USERPROFILE%\Downloads\icons\icns
# macOS/Linux example: ${HOME}/Downloads/icons/icns
DOWNLOAD_DIR=%USERPROFILE%\Downloads\icons\icns

# Optional: separate output directory for .ico files
# If omitted, .ico files follow DOWNLOAD_DIR behavior.
DOWNLOAD_DIR_ICO=%USERPROFILE%\Downloads\icons\ico

# Optional: default search/download limit (positive integer)
DEFAULT_LIMIT=25

# Optional: cache TTL in hours (positive number)
CACHE_TTL_HOURS=24

# Optional: delete newly-downloaded .icns after successful .ico conversion
# Accepted true values: 1, true, yes, on
DELETE_ICNS_AFTER_CONVERT=false
