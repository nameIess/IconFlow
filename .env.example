# Client-side search settings.
# These values are public in a Vite browser build and must not contain API secrets.

# Icons returned per search page.
VITE_SEARCH_PAGE_SIZE=50

# Minimum delay between outbound search requests.
VITE_MIN_SEARCH_INTERVAL_MS=550

# How long successful search pages stay cached in the browser.
VITE_SEARCH_CACHE_TTL_MS=2592000000

# How long to wait before retrying the primary key after a 429 response.
VITE_RATE_LIMIT_COOLDOWN_MS=60000
